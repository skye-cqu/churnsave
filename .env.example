# PayPal REST credentials (developer.paypal.com -> Apps & Credentials).
# Leave PAYPAL_CLIENT_ID/SECRET empty to run in MOCK mode (default, no credentials needed).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Webhook ID from the PayPal developer dashboard (live/sandbox signature verification).
PAYPAL_WEBHOOK_ID=
# Force mock mode even when credentials are present (1 = mock, 0 = use real sandbox API).
PAYPAL_MOCK=1

# ---------------------------------------------------------------------------
# LLM decision layer (Nebius Token Factory — any OpenAI-compatible endpoint works)
# Without a key the agent runs the deterministic offline MockProvider.
# Get a free key at https://build.nebius.ai (API keys) — see docs/NEBIUS.md.
# ---------------------------------------------------------------------------
# Master switch: false = pure rules, no LLM calls at all.
LLM_ENABLED=true
NEBIUS_API_KEY=
# NVIDIA open model served by Nebius (default shown).
NEBIUS_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# Override to point at any other OpenAI-compatible endpoint.
# OPENAI_COMPAT_BASE_URL=https://api.studio.nebius.ai/v1
# LLM call budget in ms; on timeout the agent falls back to rule copy.
# NEBIUS_TIMEOUT_MS=3000
